{
    "workbench.colorCustomizations": {
        "activityBar.activeBackground": "#3c3fae",
        "activityBar.background": "#3c3fae",
        "activityBar.foreground": "#e7e7e7",
        "activityBar.inactiveForeground": "#e7e7e799",
        "activityBarBadge.background": "#2f1011",
        "activityBarBadge.foreground": "#e7e7e7",
        "commandCenter.border": "#e7e7e799",
        "sash.hoverBorder": "#3c3fae",
        "statusBar.background": "#2f3188",
        "statusBar.foreground": "#e7e7e7",
        "statusBarItem.hoverBackground": "#3c3fae",
        "statusBarItem.remoteBackground": "#2f3188",
        "statusBarItem.remoteForeground": "#e7e7e7",
        "titleBar.activeBackground": "#2f3188",
        "titleBar.activeForeground": "#e7e7e7",
        "titleBar.inactiveBackground": "#2f318899",
        "titleBar.inactiveForeground": "#e7e7e799"
    },
    "peacock.color": "#2f3188",
    "errorLens.gutterIconsEnabled": true,
    "errorLens.gutterIconSet": "default",
    "C_Cpp.intelliSenseMemoryLimit": 4096,
    "C_Cpp.loggingLevel": "None",
    "files.exclude": {
        "**/.vscode/templates/**": true
    },
    "C_Cpp.files.exclude": {
        "**/.vscode/templates/**": true,
        "**/build/**": true
    },
    "terminal.integrated.fontFamily": "'Jetbrains Mono', monospace",
    "material-icon-theme.folders.associations": {
        "exceptions": "error",
        "controllers": "config",
    },
    "material-icon-theme.files.associations": {
        "conanfile.txt": "parcel",
        "conanfile.py": "parcel",
        "CMakeUserPresets.json": "cmake"
    },
    "files.associations": {
        "ostream": "cpp"
    },
    "makefile.configureOnOpen": false,
    "VsCodeTaskButtons.tasks": [
        {
            "label": "🏭 Install (Debug)",
            "task": "Install (Debug)",
        },
        {
            "label": "⚙️ Configure (Debug)",
            "task": "Configure (Debug)",
        },
        {
            "label": "🛠️ Build (Debug)",
            "task": "Build (Debug)",
        },
    ],
    "QuickRunPanel.includeTasks": false
}