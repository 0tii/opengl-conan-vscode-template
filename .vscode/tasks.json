{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install (Debug)",
      "type": "shell",
      "command": "conan",
      "args": [
        "install",
        ".",
        "--output-folder=build/debug",
        "-s",
        "build_type=Debug",
        "--build=missing"
      ],
      "problemMatcher": []
    },
    {
      "label": "Configure (Debug)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--preset",
        "conan-default"
      ],
      "problemMatcher": []
    },
    {
      "label": "Build (Debug)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "build/debug"
      ],
      "problemMatcher": []
    },
    {
      "label": "Full Build Debug (All Steps)",
      "type": "shell",
      "dependsOn": [
        "Install (Debug)",
        "Configure (Debug)",
        "Build (Debug)"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Configure and Build (Debug)",
      "type": "shell",
      "dependsOn": [
        "Configure (Debug)",
        "Build (Debug)"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
  ]
}